class Smartphone:
    def __init__(self, brand, model):
        self.brand = brand
        self.model = model
        self.apps = []

    def install_app(self, app):
        self.apps.append(app)
        print(app, "installed successfully")

    def uninstall_app(self, app):
        if app in self.apps:
            self.apps.remove(app)
            print(app, "uninstalled successfully")

class Manager(Smartphone):
    def display(self):
        print("Brand:", self.brand)
        print("Model:", self.model)
        print("Apps:", self.apps)

phone = Manager("Samsung", "A15")

phone.install_app("WhatsApp")
phone.install_app("YouTube")

phone.display()

phone.uninstall_app("YouTube")

phone.display()
